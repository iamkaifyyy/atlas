# ==========================================
# Atlas | Environment Configuration
# ==========================================

# Blockchain RPC (Default: Local Anvil or Sepolia RPC)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Agent Wallet Private Key
# For local Anvil, use account 1 (0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d)
AGENT_PRIVATE_KEY=your_agent_private_key_here

# Vault Owner Private Key
# For local Anvil, use account 0 (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
OWNER_PRIVATE_KEY=your_owner_private_key_here

# Deployed AgentVault Address (populated after running deploy script)
VAULT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
NEXT_PUBLIC_VAULT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# Agent Runner Ports & Endpoints
AGENT_RUNNER_PORT=3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
